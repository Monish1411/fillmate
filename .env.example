# ─────────────────────────────────────────────────────────────
# FillMate — environment configuration
# Copy to `.env.local` for development.  Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
# Public origin used for invite links & absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign session cookies (HMAC-SHA256).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=dev-only-change-me-to-a-long-random-string

# Secure flag on the session cookie.
# Leave unset in production behind HTTPS. Set to false ONLY when serving a
# production build over plain HTTP on a trusted LAN — browsers silently drop
# Secure cookies over http://, which breaks sign-in.
# COOKIE_SECURE=false

# ── Database (PostgreSQL) ─────────────────────────────────────
# Leave EMPTY to run on the built-in local SQLite driver (zero-config dev/demo).
# Set to a Postgres connection string for production.
# Supabase:  postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=

# ── Supabase (optional — Storage + Realtime) ──────────────────
# If set, evidence images are stored in a private Supabase Storage bucket
# and realtime fan-out uses Supabase Realtime instead of the built-in SSE bus.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fillmate-evidence

# ── AI verification (server-side only — never exposed to browser) ──
# Provider: openai | gemini | heuristic
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# OpenAI
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Google Gemini
# AI_PROVIDER=gemini
# AI_API_KEY=AIza...
# AI_MODEL=gemini-2.0-flash

# ── Demo mode ─────────────────────────────────────────────────
# Seeds realistic sample data and enables the "Demo" banner in the UI.
# Set to "false" in production.
NEXT_PUBLIC_DEMO_MODE=true

# ── Uploads ───────────────────────────────────────────────────
# Max evidence photo size in megabytes (1–10).
MAX_UPLOAD_MB=8

# ── Admin bootstrap ───────────────────────────────────────────
# Optional. On first run, a super admin is created with this email.
SUPER_ADMIN_EMAIL=admin@fillmate.app
SUPER_ADMIN_PASSWORD=