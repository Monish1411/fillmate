{
  "name": "fillmate",
  "version": "1.0.0",
  "private": true,
  "description": "FillMate - shared accountability for hostel water refills.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --conditions=react-server --import tsx scripts/setup-db.ts",
    "db:reset": "node --conditions=react-server --import tsx scripts/setup-db.ts --reset",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "demo:reset": "node --conditions=react-server --import tsx scripts/setup-db.ts --reset --seed",
    "gen:icons": "node --conditions=react-server --import tsx scripts/generate-icons.ts",
    "gen:migrations": "node --conditions=react-server --import tsx scripts/generate-migrations.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "db:doctor": "node --conditions=react-server --import tsx scripts/db-doctor.ts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "0.549.0",
    "motion": "12.29.3",
    "next": "15.5.27",
    "pg": "8.16.3",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "recharts": "2.15.4",
    "server-only": "0.0.1",
    "sharp": "0.34.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.4",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
